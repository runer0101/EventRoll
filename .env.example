# =============================================================================
# EventRoll — Variables de entorno para Docker Compose (local y VPS)
# =============================================================================
# Copiar a .env y ajustar valores antes de ejecutar 'docker compose up'
#   cp .env.example .env

# ─── Dominio (requerido para SSL en VPS, opcional en local) ─────────────
DOMAIN=localhost
# Para VPS con reverse proxy externo:  DOMAIN=eventroll.tudominio.com
# Para VPS con SSL propio:             DOMAIN=tudominio.com

# ─── Let's Encrypt (solo si usás certbot propio; no necesario si el SSL lo maneja otro nginx) ──
LETSENCRYPT_EMAIL=admin@tudominio.com

# ─── Base de datos ───────────────────────────────────────────────────────
DB_PASSWORD=cambia_esta_password_segura

# ─── JWT ──────────────────────────────────────────────────────────────────
JWT_SECRET=cambia_este_secreto_por_64_caracteres_aleatorios
# Generar: openssl rand -hex 64

# ─── CORS / Frontend ─────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost
# Para VPS: CORS_ORIGIN=https://eventroll.tudominio.com
FRONTEND_URL=http://localhost
# Para VPS: FRONTEND_URL=https://eventroll.tudominio.com

# ─── Build del frontend ───────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000/api
# Para VPS: VITE_API_URL=https://eventroll.tudominio.com/api
# Para GitHub Pages: VITE_API_URL=https://eventroll.onrender.com/api
VITE_BASE_URL=/
# Para GitHub Pages: VITE_BASE_URL=/EventRoll/
# Para VPS / local: VITE_BASE_URL=/

# ─── Email (recuperación de contraseña, opcional) ─────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_app_password
EMAIL_ADMIN_BACKUP=admin@tudominio.com
EMAIL_FROM_NAME=EventRoll

# ─── Opcionales (ajustar solo si es necesario) ────────────────────────────
JWT_EXPIRES_IN=24h
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
SALT_ROUNDS=10
LOG_LEVEL=info

# ─── Admin seed (primer deploy) ─────────────────────────────────────────
DEFAULT_ADMIN_EMAIL=admin@ejemplo.com
DEFAULT_ADMIN_PASSWORD=password_seguro_admin
# Generar contraseña: openssl rand -base64 12
