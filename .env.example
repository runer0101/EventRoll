# PostgreSQL connection string.
# Local development: use the credentials from docker-compose.yml.
DATABASE_URL="postgresql://eventroll:eventroll@localhost:5432/eventroll?schema=public"

# Secret used to sign NextAuth JWT tokens.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"

# Stripe (test mode) — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
# Price ID of the PRO monthly plan (Stripe Dashboard → Products).
STRIPE_PRICE_PRO="price_replace_me"

# Public base URL of the app (used for Stripe redirects).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
