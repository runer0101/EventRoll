# =============================================================================
# EventRoll — Variables de entorno para VPS (producción)
# =============================================================================
# Copiar este archivo como .env en /var/www/eventroll en el VPS
# Ajustar DB_PASSWORD y JWT_SECRET con valores reales

# ─── Dominio ──────────────────────────────────────────────────────────────
DOMAIN=eventroll.zentramid.eu.cc

# ─── Let's Encrypt (el SSL lo maneja el nginx de Zentramind) ──────────────
# No se requiere certbot de EventRoll en VPS
LETSENCRYPT_EMAIL=admin@zentramid.eu.cc

# ─── Base de datos ──────────────────────────────────────────────────────
DB_PASSWORD=REEMPLAZAR_CON_PASSWORD_SEGURA

# ─── JWT ────────────────────────────────────────────────────────────────
JWT_SECRET=REEMPLAZAR_CON_64_CARACTERES_ALEATORIOS
JWT_EXPIRES_IN=24h

# ─── CORS / Frontend ────────────────────────────────────────────────────
CORS_ORIGIN=https://eventroll.zentramid.eu.cc
FRONTEND_URL=https://eventroll.zentramid.eu.cc

# ─── Build del frontend ──────────────────────────────────────────────────
VITE_API_URL=https://eventroll.zentramid.eu.cc/api
VITE_BASE_URL=/

# ─── Email (recuperación de contraseña) ──────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=REEMPLAZAR_CON_EMAIL
EMAIL_PASS=REEMPLAZAR_CON_APP_PASSWORD
EMAIL_ADMIN_BACKUP=admin@zentramid.eu.cc
EMAIL_FROM_NAME=EventRoll

# ─── Rate Limiting ──────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Bcrypt ─────────────────────────────────────────────────────────────
SALT_ROUNDS=10

# ─── Logging ────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Admin seed (primer deploy, luego cambiar desde el panel) ───────────
DEFAULT_ADMIN_EMAIL=admin@zentramid.eu.cc
DEFAULT_ADMIN_PASSWORD=REEMPLAZAR_CON_PASSWORD_SEGURA_ADMIN

# ─── SSL de PostgreSQL (desactivado en VPS con BD local) ────────────────
DB_SSL=false
